# ──────────────────────────────────────────────────────────────
# Root .env.example — All environment variables across services
# Copy to .env and fill in values before deploying.
# ──────────────────────────────────────────────────────────────

# ── URL Summarizer (services/url-summarizer, port 9003) ─────
URL_SUMMARIZER_PORT=9003
LLM_API_KEY=                        # Required — LLM provider API key
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
LLM_MAX_TOKENS=1024
MISTRAL_API_KEY=                    # Alias for LLM_API_KEY (Mistral-specific)
API_KEYS_PATH=./data/api-keys.json
FREE_TIER_DAILY_LIMIT=25
FETCH_TIMEOUT_MS=15000
MAX_CONTENT_CHARS=50000
LOG_LEVEL=info                      # debug | info | warn | error
ADMIN_SECRET=                       # Secret for API key management endpoints

# ── x402 API (services/x402-api, port 9402) ─────────────────
# PORT is also used by x402-api as its listen port
WALLET_ADDRESS=                     # Your USDC wallet on Base (receives x402 payments)
FACILITATOR_URL=https://x402.org/facilitator  # x402 payment verification facilitator

# ── Landing Page (services/landing-page, port 3000) ─────────
LANDING_PORT=3000
# WALLET_ADDRESS is shared — also used by landing page
GATEWAY_WALLET_ADDRESS=             # Alias for WALLET_ADDRESS (landing page fallback)

# ── Invoice Parser (app/, port 8000) ────────────────────────
# Uses default FastAPI/Uvicorn settings; no custom env vars in MVP.
# PORT=8000                         # Uvicorn bind port (set in Procfile/nixpacks)

# ── x402 Gateway (src/gateway, port 7402) ───────────────────
GATEWAY_PORT=7402
GATEWAY_WALLET_ADDRESS=             # Wallet address for gateway payment verification
GATEWAY_DB_PATH=./data/gateway.db   # SQLite DB for nonce tracking
WALLET_PATH=./data/wallet.json      # Path to wallet key file
BASE_RPC_URL=https://mainnet.base.org  # Base L2 RPC endpoint

# ── Database (inferred-analysis subsystem) ───────────────────
DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PAPERCLIP_URL=http://localhost:3100

# ── Market Data ──────────────────────────────────────────────
ALPHA_VANTAGE_KEY=

# ── Trading (optional) ──────────────────────────────────────
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Notifications ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Daemon Tuning ────────────────────────────────────────────
# DAEMON_INTERVAL=900               # Seconds between research cycles
# DAEMON_ITERATIONS=5               # Experiments per cycle

# ── Railway ──────────────────────────────────────────────────
# RAILWAY_TOKEN=                    # Railway deploy token (CI/CD)
# RAILWAY_PROJECT_ID=               # Railway project ID
