{
  "name": "battle-born-intelligence",
  "private": true,
  "version": "5.0.0",
  "description": "Datchi Automaton - Sovereign AI Agent Runtime",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.js": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./state/database.js": {
      "types": "./dist/state/database.d.ts",
      "default": "./dist/state/database.js"
    }
  },
  "bin": {
    "automaton": "dist/index.js",
    "datchi-automaton": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/datchi-app/automaton.git"
  },
  "homepage": "https://datchi.app",
  "keywords": [
    "autonomous-agent",
    "sovereign-ai",
    "web4",
    "datchi",
    "self-replicating"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && pnpm -r build",
    "preview": "vite preview",
    "dev:watch": "tsx watch src/index.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "test:security": "node node_modules/vitest/vitest.mjs run --grep \"security|injection|policy\"",
    "test:financial": "node node_modules/vitest/vitest.mjs run --grep \"financial|spend|treasury\"",
    "test:ci": "node node_modules/vitest/vitest.mjs run --reporter=verbose",
    "clean": "rm -rf dist && pnpm -r clean",
    "update-niches": "tsx src/knowledge/cli-update-niches.ts",
    "collect-tax": "tsx src/treasury/cli-collect-tax.ts",
    "seed-goals": "tsx src/cli-seed-goals.ts"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "cron-parser": "^4.9.0",
    "d3": "^7.9.0",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "openai": "^6.24.0",
    "ora": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-git": "^3.24.0",
    "siwe": "^2.3.0",
    "ulid": "^2.3.0",
    "viem": "^2.44.2",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
